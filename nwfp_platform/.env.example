# ---------------------------------------------------------------------------
# Bhutan NWFP Digital Marketplace — Environment variables template
#
# Copy this file to .env and fill in the values for your environment.
# NEVER commit the real .env file to version control.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------
# A long, random string — minimum 50 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(60))"
SECRET_KEY=your-secret-key-here-min-50-chars-change-this-before-running

# Set to True only in development; must be False in production
DEBUG=True

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostGIS URL format: postgis://USER:PASSWORD@HOST:PORT/DBNAME
# For SpatiaLite (no PostGIS server required): set USE_SPATIALITE=True below
DATABASE_URL=postgis://nwfp_user:nwfp_pass@localhost:5432/nwfp_db

# ---------------------------------------------------------------------------
# Allowed hosts
# ---------------------------------------------------------------------------
# Comma-separated list of hostnames that Django will serve
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Media files
# ---------------------------------------------------------------------------
# Absolute path where user-uploaded files are stored
MEDIA_ROOT=/app/media

# ---------------------------------------------------------------------------
# SpatiaLite (development alternative to PostGIS)
# ---------------------------------------------------------------------------
# Set to True to use a local SQLite+SpatiaLite database instead of PostGIS.
# Useful when a PostGIS server is not available on the developer's machine.
USE_SPATIALITE=False
# If USE_SPATIALITE=True, optionally set the path to mod_spatialite:
# SPATIALITE_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/mod_spatialite.so

# ---------------------------------------------------------------------------
# Email (production)
# ---------------------------------------------------------------------------
# EMAIL_BACKEND is overridden to console in development.py automatically.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True

# ---------------------------------------------------------------------------
# Redis (production caching)
# ---------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Sentry error tracking (production)
# ---------------------------------------------------------------------------
# SENTRY_DSN=https://your-key@sentry.io/your-project-id
# SENTRY_TRACES_SAMPLE_RATE=0.1
# APP_VERSION=1.0.0

# ---------------------------------------------------------------------------
# AWS S3 / compatible object storage (production, optional)
# ---------------------------------------------------------------------------
# USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=nwfp-media
# AWS_S3_REGION_NAME=ap-southeast-1
# AWS_S3_CUSTOM_DOMAIN=

# ---------------------------------------------------------------------------
# Connection pooling (production)
# ---------------------------------------------------------------------------
# CONN_MAX_AGE=60
